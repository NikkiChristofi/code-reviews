// Prisma schema for the code-reviews technical test.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A simple greeting record used to prove the DB -> API -> UI path works.
model Greeting {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

/// A country as described by the World Bank API (aggregates such as "World" are excluded).
model Country {
  /// ISO 3166-1 alpha-3 code, e.g. "GBR"
  code            String  @id
  /// ISO 3166-1 alpha-2 code, e.g. "GB"
  iso2Code        String  @unique
  name            String
  /// World Bank region name, e.g. "Europe & Central Asia"
  region          String
  regionCode      String
  /// World Bank income classification, e.g. "High income"
  incomeLevel     String
  incomeLevelCode String
  capitalCity     String?
  latitude        Float?
  longitude       Float?

  observations Observation[]
}

/// A World Bank indicator (a measurable series such as GDP per capita).
model Indicator {
  /// World Bank indicator code, e.g. "NY.GDP.PCAP.CD"
  code               String    @id
  name               String
  sourceNote         String?
  sourceOrganization String?
  /// When observations for this indicator were last pulled from the API
  lastFetchedAt      DateTime?

  observations Observation[]
  savedViews   DashboardView[]
}

/// One value of one indicator for one country in one year.
model Observation {
  id            Int    @id @default(autoincrement())
  countryCode   String
  indicatorCode String
  year          Int
  value         Float

  country   Country   @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorCode], references: [code], onDelete: Cascade)

  @@unique([countryCode, indicatorCode, year])
  @@index([indicatorCode, year])
}

/// A saved dashboard configuration (the controls' selections at the time of saving).
model DashboardView {
  id            Int      @id @default(autoincrement())
  /// User-supplied label shown in the saved views dropdown
  name          String
  indicatorCode String
  year          Int
  /// Ranking order: "ASC" or "DESC" (mirrors the GraphQL SortOrder enum)
  sortOrder     String
  /// Highlighted World Bank region, or null for all regions
  region        String?
  /// Comma-separated ISO3 codes, e.g. "GBR,USA,FRA"
  countryCodes  String
  createdAt     DateTime @default(now())

  indicator Indicator @relation(fields: [indicatorCode], references: [code], onDelete: Cascade)
}
